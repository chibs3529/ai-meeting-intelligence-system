    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"temperature\": 0.2,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a meeting intelligence engine for Nigerian business meetings. You receive raw meeting transcripts that were auto-generated from audio. IMPORTANT CONTEXT: transcripts may mix English, Igbo, Yoruba, Hausa, and Nigerian Pidgin, sometimes switching mid-sentence, and may contain transcription errors especially in non-English segments. Use surrounding context to infer intended meaning. Output everything in English.\\n\\nYour job: extract structured meeting intelligence and return ONLY a valid JSON object — no markdown fences, no preamble, no explanation.\\n\\nReturn exactly this structure:\\n{\\n  \\\"summary\\\": \\\"2-3 sentence meeting summary in English\\\",\\n  \\\"decisions\\\": [\\\"list of decisions made\\\"],\\n  \\\"action_items\\\": [\\n    {\\n      \\\"task\\\": \\\"what needs to be done, in English\\\",\\n      \\\"assignee\\\": \\\"person's name or null if unclear\\\",\\n      \\\"assignee_email\\\": \\\"matched from the attendee list or null\\\",\\n      \\\"deadline\\\": \\\"YYYY-MM-DD or a plain phrase like 'Friday' or null\\\",\\n      \\\"priority\\\": \\\"high, medium, or low\\\"\\n    }\\n  ],\\n  \\\"open_questions\\\": [\\\"unresolved topics or questions\\\"],\\n  \\\"unclear_items\\\": [\\\"segments too garbled or ambiguous to interpret confidently — quote the fragment rather than guessing\\\"]\\n}\\n\\nRules:\\n- Match spoken names to the attendee list to fill assignee_email; if a task's owner is not stated, use null — never invent an owner.\\n- If no deadline is stated, use null — never invent dates.\\n- A task mentioned in Igbo, Yoruba, Hausa or Pidgin is still an action item — translate it to English.\\n- If a segment seems garbled but you can confidently infer meaning from context, extract it normally. If you cannot, put the fragment in unclear_items instead.\\n- Empty arrays are fine. The JSON must always be valid and complete.\"\n    },\n    {\n      \"role\": \"user\",\n     \"content\": {{ JSON.stringify(\"Attendees: \" + $json.body.attendees + \"\\n\\nTranscript:\\n\" + $json.body.transcript) }}\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-160, -128],
      "id": "1ddf051e-017c-4bfa-bc79-cb181b6ddb3a",
      "name": "Groq - Extract Intelligence",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Groq Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ---- Parse & Validate: Groq output → clean structured data ----\nconst raw = $input.first().json.choices[0].message.content;\n\nlet parsed;\ntry {\n  // strip any stray markdown fences, then parse\n  const clean = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  throw new Error('Groq returned invalid JSON: ' + e.message + ' | RAW: ' + raw.slice(0, 300));\n}\n\n// validate the shape — fail loudly, not silently\nif (!parsed.summary || !Array.isArray(parsed.action_items)) {\n  throw new Error('Parsed JSON missing required fields. Got keys: ' + Object.keys(parsed).join(', '));\n}\n\n// generate the meeting ID\nconst meetingId = 'MTG-' + String($now.toMillis()).slice(-6);\n\n// pull the original inputs through for later nodes\nconst webhookBody = $('Webhook').first().json.body;\n\nreturn [{\n  json: {\n    meeting_id: meetingId,\n    processed_at: $now.toISO(),\n    attendees_raw: webhookBody.attendees || '',\n    summary: parsed.summary,\n    decisions: parsed.decisions || [],\n    action_items: parsed.action_items || [],\n    open_questions: parsed.open_questions || [],\n    unclear_items: parsed.unclear_items || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, -128],
      "id": "ba014e16-d879-4a8d-936d-111d9a5c1cf3",
      "name": "Parse and Validate"
    },
